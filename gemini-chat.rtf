\cf10 \cb9 pub\cf4  \cf10 async\cf4  \cf10 fn\cf4  \cf13 process_input\cf4 (&\cf10 self\cf4 , text: &\cf14 str\cf4 ) -> \cf14 Result\cf4 <\cf14 String\cf4 , SkillError> \{\
    \cf11 // 1. Check if model is in config\cf4 \
    \cf10 let\cf4  model = \cf10 match\cf4  &\cf10 self\cf4 .config.llm.default_model \{\
        \cf15 Some\cf4 (m) => m,\
        \cf15 None\cf4  => \cf10 return\cf4  \cf15 Err\cf4 (SkillError::NoModelConfigured(\cf12 "Please set a default model to use prompting."\cf4 )),\
    \};\
\
    \cf11 // 2. Start the 3-man loop\cf4 \
    \cf10 let\cf4  context = \cf10 self\cf4 .researcher.gather_context(text).\cf10 await\cf4 ?;\
    \cf10 let\cf4  response = \cf10 self\cf4 .actor.generate_response(text, context, model).\cf10 await\cf4 ?;\
    \
    \cf11 // 3. Trigger Reviewer (Async)\cf4 \
    \cf10 let\cf4  reviewer_task = \cf10 self\cf4 .reviewer.spawn_deduction_task(text, &response);\
    \
    \cf15 Ok\cf4 (response)\
\}\
